TELEGRAM_TOKEN=your-bot-token-here
POLL_INTERVAL_SECONDS=300
DATABASE_PATH=subscriptions.db

# Timeout in seconds for each HTTP request to AEMET.
HTTP_TIMEOUT_SECONDS=20
# Maximum number of concurrent HTTP requests to AEMET across all regions.
HTTP_MAX_CONCURRENCY=8
# Number of retries after a failed request (network error or 5xx response).
HTTP_MAX_RETRIES=2
# HTTP_USER_AGENT is fixed in code (not read from the environment): the bot
# identifies itself to AEMET as "aemet-avisos-bot/0.2 (+https://github.com/jaimebg/aemet-avisos-bot)".
